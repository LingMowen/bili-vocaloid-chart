{
  "name": "bili-vocaloid-chart",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "node --watch apps/api/src/index.js",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "backup": "bash scripts/backup.sh",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:check": "node scripts/install-hooks.js --check",
    "preflight": "node scripts/preflight.js",
    "preflight:selftest": "node scripts/preflight-selftest.js",
    "changelog": "node scripts/changelog.js",
    "svc": "node scripts/dev.js",
    "svc:start": "node scripts/dev.js start",
    "svc:stop": "node scripts/dev.js stop",
    "svc:restart": "node scripts/dev.js restart",
    "svc:status": "node scripts/dev.js status"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
