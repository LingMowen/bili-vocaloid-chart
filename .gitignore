# ============================================================
# bili-vocaloid-chart — Git 忽略规则
# 原则：只提交「源码 + 文档 + 参考基准」，其余（依赖 / 构建产物 /
#       运行时缓存 / 凭据 / 大体积会话导出）一律不入库。
# ============================================================

# ---------- 依赖 ----------
node_modules/
**/node_modules/

# ---------- 构建产物 ----------
dist/
**/dist/
build/
**/build/
*.stale-*
apps/web/vite.config.js.timestamp-*.mjs

# ---------- 运行时数据与缓存（体积大、可重建） ----------
apps/api/cache/
apps/api/.data/
apps/api/*.log
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---------- 运行日志（服务/预览/dev server，可重建） ----------
*.log
!1/.workbuddy/tmp/*.log
*.err
_web_*

# ---------- 临时备份残留（改代码时的手工 .bak-<时间戳>，正式备份在 .workbuddy/backups/） ----------
*.bak-*
apps/api/src/*.bak*

# ---------- 环境变量（含 BILIBILI_COOKIE / AI 密钥等凭据） ----------
.env
.env.*
!.env.example

# ---------- 会话导出与抓取产物（体积大，且含账号明文） ----------
evocalrank-com.json
Open CODE*.json
*.json.bak
temp-check.js
tmp-*.json
tmp-*.log
tmp-ref*.log

# ---------- 临时脚本与截图 ----------
tmp-*
tmp_*
tmp-ui/

# ---------- 临时目录（wizard / 本地试验产物，勿入库） ----------
tmp/
.tmp/
_tmp/

# ---------- Playwright MCP 运行日志/截图（含验证码截图，勿入库） ----------
.playwright-mcp/

# ---------- 参考站整站镜像 ----------
/1/

# ---------- 开发过程资料与第三方参考代码（只在本地保留，不随仓库发布） ----------
# 开发记忆 / 助手工作区 / 备份
.workbuddy/
.workbuddy-ai/
# 参考站页面 / 接口 / DOM 快照与参考资料
.reference/
参考文件/
# ---------- 过程记录类文档（只在本地保留，不入库）----------
# 用户口径（2026-10-10）：GitHub 仓库只保留「项目介绍 / 对外契约」类文档，
# 过程记录（开发日志、运维手册、变更史、改造方案与勘察笔记）一律不上传，
# 历史提交里的也要一并清除（已用 git filter-branch 重写，备份在仓库外）。
# 为什么：这些内容含服务器路径、部署细节、内部决策痕迹，属运维隐私，
# 且与「项目介绍」定位无关。
/docs/开发日志.md
/docs/变更史.md
/docs/云端部署运维手册.md
/docs/scoring/
# 彩虹聚合登录官方 PHP 示例 SDK（第三方参考代码，与本项目 Node 后端无关）
/SDK/
# 一次性环境安装脚本（仅供本地使用，不入库）
/scripts/install-gh-windows.sh
# 开发期截图 / 对比图
home-before.png
*.before.png
*.after.png

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp

# ---------- 归档：已退出版本库的历史资料 / 早期调试产物（2026-10-02 归拢） ----------
/old-files/
