# ============================================================
# xngschina 后端环境变量模板
#
# ⚠️ 本仓库不包含任何真实凭据：下面所有的 cookie / 密钥 / 邮箱密码
#    一律留空，**需要你自己填写**。
#
# 用法（必须在 apps/api 目录下）：
#     cp .env.example .env
#     # 然后把下面的值填进新建的 .env
#
# - 后端用 dotenv 从**当前工作目录**读 .env，所以在 apps/api 下启动才行。
# - `.env` 已被 .gitignore 忽略（`.env.example` 是唯一例外），不会被提交。
# - 只做公开榜单浏览时，本文件可以全部留空也能跑起来；
#   但采集（B 站登录态）、AI 审核、第三方登录、邮箱验证码会不可用。
# ============================================================

# ---------- 基础 ----------

# 后端监听端口。前端 vite.config.js 的 proxy 默认指向 1003
PORT=1003

# 缓存目录（榜单 / 全库 / 快照 / 审核结果 JSON）。留空 = 默认 apps/api/cache
# CACHE_DIR=

# 待审池里单条最多重试次数，默认 5
# PENDING_MAX_ATTEMPTS=5

# 从 vocabili 参考数据同步时的请求节流，单位毫秒，默认 250
# VOCABILI_THROTTLE_MS=250

# ---------- B 站登录态（需要你自己填） ----------

# 【建议填写】B 站登录态 cookie 串，格式：name=value; name=value; ...
# 获取方式：浏览器登录 bilibili.com → F12 → Application → Cookies
#           → https://www.bilibili.com → 取出至少 SESSDATA / bili_jct / DedeUserID
# 用途：SDK 请求 /x/space/wbi/acc/info 等需要登录态的接口。
# 留空时启动日志会出现「[bili] wbi 初始化失败: [BiliApi -101] 账号未登录」。
# ⚠️ 这是账号凭据：只放在本文件里，不要提交、不要贴到 issue / 聊天里。
BILIBILI_COOKIE=

# 遗留项：config.js 会读取，但当前代码没有实际使用，可留空
SESSDATA=

# ---------- 前端与会话 ----------

# 前端地址，用于第三方登录回调成功后的跳转
FRONTEND_URL=http://localhost:1005

# 会话签名密钥。生产环境必须改成随机长字符串；
# 留空会退化成代码里的开发默认值（不安全）
SESSION_SECRET=

# ---------- AI 审核（可选） ----------
# 判定视频是否为虚拟歌姬演唱，走 OpenAI 兼容接口。
# AI_REVIEW_ENABLED=false 或 AI_REVIEW_BASE/KEY 为空时：不请求上游、不启动审核 worker，
# 单例调用一律 fail-open 放行（即不拦截收录）。
# 注意：上游一般有频率限制（本项目按 300 分钟 600 次、30 秒/次串行设计）
AI_REVIEW_ENABLED=true
AI_REVIEW_BASE=
AI_REVIEW_KEY=
AI_REVIEW_MODEL=step-3.5-flash

# ---------- 彩虹聚合登录（可选，CC云 cccyun） ----------
# 需要你自己到 https://u.cccyun.cc/ 申请 appid / appkey
CCCYUN_API_URL=https://u.cccyun.cc/
CCCYUN_APPID=1000
# 下面的值是上游文档里的示例值，**必须换成你自己的 appkey**，否则登录不可用
CCCYUN_APPKEY=1111111111111111111111111111
# 回调地址需与 cccyun 平台上填写的一致
CCCYUN_CALLBACK=http://localhost:1003/api/auth/oauth/callback
# 启用的第三方渠道，逗号分隔
OAUTH_TYPES=qq,wx

# ---------- SMTP 邮箱验证码登录（可选） ----------
# SMTP_ENABLED=false 时整体停用；改为 true 才需要下面这些
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
# 发信账号与授权码 / 密码（需要你自己填）
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
