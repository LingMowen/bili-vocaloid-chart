PORT=1003
# 可选：bilibili 登录态 cookie 串（name=value; ...，浏览器登录 bilibili 后 F12 -> Cookies）
# 用于 SDK 请求 /x/space/wbi/acc/info 等接口（可留空，B 站可能限流）
BILIBILI_COOKIE=

# 前端地址（OAuth 回调成功后跳转目标）
FRONTEND_URL=http://localhost:1005
# 会话签名密钥（生产必改）
SESSION_SECRET=

# ---- AI 审核（判定视频是否为虚拟歌姬演唱，OpenAI 兼容接口）----
# 上游限 300 分钟 600 次；未配置时审核跳过（不拦截收录）
# 总开关：false = 彻底停用 AI（不启动审核 worker、不请求上游、单例调用 fail-open 放行）
# 设为 true 或注释掉即恢复（默认 true）
AI_REVIEW_ENABLED=true
AI_REVIEW_BASE=
AI_REVIEW_KEY=
AI_REVIEW_MODEL=step-3.5-flash

# ---- 彩虹聚合登录（CC云 cccyun）----
CCCYUN_API_URL=https://u.cccyun.cc/
CCCYUN_APPID=1000
CCCYUN_APPKEY=1111111111111111111111111111
# 回调地址需与 cccyun 平台配置一致
CCCYUN_CALLBACK=http://localhost:1003/api/auth/oauth/callback
# 启用的第三方渠道，逗号分隔
OAUTH_TYPES=qq,wx

# ---- SMTP 邮箱验证码登录 ----
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=